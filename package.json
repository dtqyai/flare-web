{
  "name": "flare-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "bash scripts/build-cloudflare.sh",
    "deploy": "wrangler deploy",
    "test:deploy": "node --test tests/deployment/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "wrangler": "4.151.3"
  }
}
